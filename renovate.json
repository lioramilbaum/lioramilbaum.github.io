{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>lioramilbaum/renovate-config"
  ],
  "pinDigests": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Playwright image pinned in scripts/snapshot-site.sh",
      "managerFilePatterns": ["/^scripts/snapshot-site\\.sh$/"],
      "matchStrings": [
        "image=\"(?<depName>mcr\\.microsoft\\.com/playwright):(?<currentValue>v[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Group all GitHub Actions updates into a single PR",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "pinDigests": true
    },
    {
      "description": "Automerge non-major GitHub Actions updates once check-site passes",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "platformAutomerge": false
    },
    {
      "description": "Automerge non-major Playwright image and npm updates once check-site passes",
      "matchManagers": ["custom.regex", "npm"],
      "matchDepNames": ["mcr.microsoft.com/playwright", "playwright"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "platformAutomerge": false
    },
    {
      "description": "Move the Playwright image and the npm playwright package in one PR, so the lockfile version matches the image",
      "matchDepNames": ["mcr.microsoft.com/playwright", "playwright"],
      "groupName": "Playwright"
    }
  ]
}
